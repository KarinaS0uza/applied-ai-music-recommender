# Behavior: keeps caches, virtualenvs, local-only files and private provider keys out of git.

# Byte compiled
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
env/
venv/

# OS files
.DS_Store

# Pytest cache
.pytest_cache/

# Local-only files
.planning/

# Private provider configuration
.env
.env.*
!.env.example
.streamlit/secrets.toml
